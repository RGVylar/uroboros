# Uroboros — reverse proxy + static frontend
#
# OJO: install.sh lleva su propia copia en linea de esta config (un heredoc
# que escribe /etc/caddy/Caddyfile). Este fichero es la referencia, pero el
# que se despliega es aquel: si tocas uno, toca el otro.
# Listens on all IPs on port 80 (ideal for local network or behind Cloudflare Tunnel)

:80 {
	encode gzip

	# Subida de foto de perfil. Va ANTES del /api/* de abajo porque los handle
	# se evalúan en orden y el primero que casa gana.
	#
	# Este es el tope de verdad del tamaño de subida: corta la conexión sin que
	# el backend llegue a bufferizar nada. El límite de la app (4 MB) es la
	# segunda línea. 5 MB y no 4 para que el multipart quepa con su envoltorio y
	# el usuario vea nuestro 413 con mensaje, no un error seco de Caddy.
	@avatar_upload path /api/users/me/avatar-photo
	handle @avatar_upload {
		request_body {
			max_size 5MB
		}
		reverse_proxy 127.0.0.1:__BACKEND_PORT__
	}

	# Fotos de perfil: las da Caddy desde disco, sin pasar por el backend. Antes
	# las servía uvicorn (StaticFiles), o sea un proceso de Python leyendo un
	# fichero de 20 KB que este file_server despacha solo.
	#
	# handle_path (no handle) porque hay que quitar el prefijo: la URL es
	# /api/media/avatars/<uuid>.webp y el fichero está en la raíz de root.
	#
	# El año de caché es seguro porque el nombre es un UUID que no se reutiliza:
	# cambiar de foto genera otro nombre, así que nadie puede quedarse servido
	# con una versión vieja de la misma URL.
	#
	# OJO: esta ruta duplica MEDIA_DIR del .env del backend. Si cambias una,
	# cambia la otra o las fotos dejarán de verse.
	handle_path /api/media/avatars/* {
		root * /var/lib/uroboros/media/avatars
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# API — note: use 'handle', not 'handle_path', to preserve /api prefix
	handle /api/* {
		reverse_proxy 127.0.0.1:__BACKEND_PORT__
	}

	# Landing de invitación: la sirve el backend, no la SPA. Sin este bloque
	# caería en el catch-all de abajo y SvelteKit respondería con su 404.
	@unete path /unete /unete/*
	handle @unete {
		reverse_proxy 127.0.0.1:__BACKEND_PORT__
	}

	# Static SvelteKit build (adapter-static output)
	handle {
		root * __APP_DIR__/frontend/build
		# /_app/immutable/ hace honor a su nombre: SvelteKit mete un hash en cada
		# nombre de fichero, así que un mismo nombre nunca cambia de contenido.
		# Un año de caché. El resto (index.html, manifest, iconos) NO lleva hash
		# y se queda sin esta cabecera a propósito: ahí sí hace falta revalidar.
		header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
