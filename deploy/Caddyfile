# Uroboros — reverse proxy + static frontend
#
# OJO: install.sh lleva su propia copia en linea de esta config (un heredoc
# que escribe /etc/caddy/Caddyfile). Este fichero es la referencia, pero el
# que se despliega es aquel: si tocas uno, toca el otro.
# Listens on all IPs on port 80 (ideal for local network or behind Cloudflare Tunnel)

:80 {
	encode gzip

	# API — note: use 'handle', not 'handle_path', to preserve /api prefix
	handle /api/* {
		reverse_proxy 127.0.0.1:__BACKEND_PORT__
	}

	# Landing de invitación: la sirve el backend, no la SPA. Sin este bloque
	# caería en el catch-all de abajo y SvelteKit respondería con su 404.
	@unete path /unete /unete/*
	handle @unete {
		reverse_proxy 127.0.0.1:__BACKEND_PORT__
	}

	# Static SvelteKit build (adapter-static output)
	handle {
		root * __APP_DIR__/frontend/build
		try_files {path} /index.html
		file_server
	}
}
