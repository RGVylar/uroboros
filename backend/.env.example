DATABASE_URL=postgresql+psycopg2://uroboros:uroboros@localhost:5432/uroboros
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_VALUE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
OFF_BASE_URL=https://world.openfoodfacts.org
# Telegram alerts for unhandled errors (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dónde se guardan las fotos de perfil. OBLIGATORIO en producción: si se deja
# vacío caen en un directorio temporal, y el servicio lleva PrivateTmp=true, así
# que ese temporal se vacía en cada reinicio y se pierden todas.
MEDIA_DIR=/var/lib/uroboros/media
# Habilita el botón «Rechazar foto» de las alertas de moderación. Vacío = la ruta
# del webhook responde 404 (lo que quieres en local). Genéralo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# y registra el webhook una vez: .venv/bin/python scripts/set_telegram_webhook.py
TELEGRAM_WEBHOOK_SECRET=
# OCR de tickets de compra (feature receipt_scan). El binario se instala aparte:
#   apt install tesseract-ocr tesseract-ocr-spa
# Sin esto, /api/receipts/scan responde 503. En Windows suele hacer falta la ruta
# completa porque el instalador no toca el PATH, y TESSERACT_TESSDATA porque el
# idioma no cabe en Program Files sin admin:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#   TESSERACT_TESSDATA=C:\Users\<tu-usuario>\AppData\Local\Tesseract-OCR\tessdata
TESSERACT_CMD=tesseract
TESSERACT_TESSDATA=
TESSERACT_LANG=spa
