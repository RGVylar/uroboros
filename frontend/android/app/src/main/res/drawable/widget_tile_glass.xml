<?xml version="1.0" encoding="utf-8"?>
<!-- Tile de cristal oscuro de marca, esquinas grandes (Material You) y borde verde tenue. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="270"
        android:startColor="#161D2B"
        android:endColor="#0F1420" />
    <stroke
        android:width="1dp"
        android:color="#2E34E0A1" />
</shape>
